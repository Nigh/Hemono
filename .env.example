# ============================================
# Hemono - Environment Variables Configuration
# ============================================

# Backend Configuration
# ============================================
# PocketBase 数据目录
PB_DATA_DIR=/pb_data

# PocketBase 管理员邮箱（初次部署时设置）
PB_ADMIN_EMAIL=admin@example.com

# PocketBase 管理员密码（初次部署时设置）
PB_ADMIN_PASSWORD=changeme

# ============================================
# Frontend Configuration
# ============================================

# API 服务地址（开发环境）
# 生产环境通过 Caddy 反代自动处理，无需设置
VITE_API_URL=http://127.0.0.1:8090

# ============================================
# General Configuration
# ============================================

# 时区
TZ=Asia/Shanghai

# ============================================
# Docker Compose Usage
# ============================================

# 开发环境启动：
#   docker-compose -f docker-compose.dev.yml up -d
#
# 生产环境启动：
#   docker-compose -f docker-compose.prod.yml up -d
#
# 前端访问地址：
#   开发：http://localhost:5173
#   生产：https://yourdomain.com (通过 Caddy 反代)
#
# 后端 API 地址：
#   开发：http://127.0.0.1:8090
#   生产：https://yourdomain.com/api (通过 Caddy 反代)
#
# PocketBase 管理面板：
#   开发：http://127.0.0.1:8090/_/
#   生产：https://yourdomain.com/_ (通过 Caddy 反代)
